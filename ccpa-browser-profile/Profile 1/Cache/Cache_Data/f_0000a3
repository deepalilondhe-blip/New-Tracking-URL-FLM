    function onSubmitMain(event) {
        $('#ccpa-form').valid();
        if ($('#ccpa-form').valid()) {
            var formData = $('#ccpa-form').serialize();
            $('.loader').show();
            $('.submitBtn').attr("disabled", true);
            $.ajax({
                headers: {
                    'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr(
                        'content')
                },
                type: "POST",
                url: "https://tra.com/submit-ccpa",
                data: formData,
                success: function(response) {
                    // Handle the success response (e.g., show a success message)
                    // You can also redirect or perform other actions here

                    console.log('response',response);
                    if (response) {
                        // $("#success-message").show();
                        Swal.fire({
                            showCloseButton: false,
                            icon: 'success',
                            html: 'Your CCPA Request form has been submitted successfully',
                            title: 'Success!',
                            text: '',
                            customClass: {
                                popup: 'small-popup-class',
                            },
                            onOpen: () => {
                                const popup = document.querySelector(
                                    '.swal2-popup');
                                popup.style.width = '500px';
                                popup.style.fontSize = '18px';
                                popup.style.textAlign = 'center';
                            },
                            backdrop: false, // Disable the backdrop (background blur)
                            allowOutsideClick: false, // Disallow clicking outside the popup

                        }).then((result) => {
                            if (result.isConfirmed) {
                                // The "OK" button was clicked, you can perform actions here if needed
                                location
                                    .reload(); // Reload the page, for example
                            }
                        });
                    }
                },
                error: function(xhr, status, error) {
                    // Handle errors (e.g., display an error message)
                    console.error('error', xhr.responseText);
                },
                complete: function() {
                    // Hide the loading spinner after the request is complete
                    $('.loader').hide();
                    // Clear all form fields
                    $('#ccpa-form').find(
                        "input[type=text], input[type=email], input[type=radio], input[type=checkbox],input[type=tel],  select"
                    ).val('');

                    // Optionally, you can reset any radio buttons or checkboxes to their default state
                    $('#ccpa-form').find("input[type=radio], input[type=checkbox]")
                        .prop("checked", false);
                    $('.submitBtn').attr("disabled", false);
                }
            });
        }else{
           
        }
    }
